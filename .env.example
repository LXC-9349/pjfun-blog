# ===========================================
# PJ Blog 环境变量示例文件
# -------------------------------------------
# 用法：复制本文件为 .env（或 .env.local）后按需修改
# 优先级：系统环境变量 > .env.* 文件 > src/constants 中的代码默认值
# 提示：VITE_ 前缀变量会在构建时注入前端产物，请勿写入真正的机密信息
# 全量参数说明见 README.md「环境变量」与「系统参数」章节
# ===========================================

# ===========================================
# 构建与部署
# ===========================================

# 部署基础路径。
# - 部署在域名根目录（https://example.com/）时保持 /
# - 部署在子路径（如 GitHub Pages：https://user.github.io/pjfun-blog/）时设为 /pjfun-blog/
# 该值同时影响路由 base、静态资源与文章内相对图片的解析
VITE_BASE=/

# 页脚显示的语义化版本号（如 v1.2.0）。
# 留空时自动显示构建日期（vYYYY.MM.DD），鼠标悬停可看到完整构建时间。
# 仅用于展示，不参与版本更新检查
VITE_APP_VERSION=

# ===========================================
# 站点基本信息（站点配置）
# ===========================================

# 站点图标：取首字符渲染在 Logo 方块（导航栏、页脚、加载动画）
VITE_SITE_ICON=Pj
# 站点标题：浏览器标签页、导航栏、页脚、PWA 名称
VITE_SITE_TITLE=Pjfun Blog
# 站点描述：SEO description、PWA description
VITE_SITE_DESCRIPTION=零后端、纯静态、顶级动效、全球秒开的个人博客系统
# 作者名称：用于 SEO 作者字段
VITE_SITE_AUTHOR=Simon
# 站点关键词：英文逗号分隔，输出到 meta keywords
VITE_SITE_KEYWORDS=博客,技术分享,前端开发,Vue,TypeScript
# 联系邮箱：页脚邮件按钮（mailto）
VITE_SITE_EMAIL=admin@pjfun.com
# 站点域名：RSS / Atom / JSON Feed / sitemap / 结构化数据使用，结尾不要带斜杠
VITE_SITE_URL=https://pjfun.top

# ===========================================
# 首屏文案（index.html 与资源加载器）
# ===========================================

# 首屏加载动画文案
VITE_LOADING_TEXT=Loading
# 浏览器禁用 JavaScript 时的 <noscript> 提示
VITE_JS_DISABLED_NOTICE=请开启 JavaScript
# CDN 资源全部加载失败时的提示（public/pj_public.js）
VITE_RESOURCE_LOAD_FAILED_TEXT=资源加载失败,请刷新
# 检测到新构建版本、需要刷新页面时的提示
VITE_REFRESH_REQUIRED_TEXT=页面需要刷新以完成更新...

# ===========================================
# 社交与页脚链接
# ===========================================

# GitHub 仓库地址。
# 同时用于解析 owner/repo，「数据管理 / 在线编辑」入口据此拼接在线 IDE 地址
VITE_SOCIAL_GITHUB=https://github.com/LXC-9349/pjfun-blog
# Telegram 链接（页脚社交按钮）
VITE_SOCIAL_TELEGRAM=https://t.me/pjfun_top
# 页脚 GitHub 链接
VITE_FOOT_GITHUB=https://github.com/LXC-9349/pjfun-blog
# 热榜新闻入口地址（首页热门标签旁的「热榜新闻」按钮，组件始终渲染，请填写有效地址）
VITE_HOT_RANK_URL=https://www.pjfun.top/fun/rank

# ===========================================
# Giscus 评论系统
# 配置获取：https://giscus.app/zh-CN
# ===========================================

# 是否启用评论（true / false）
VITE_GISCUS_ENABLED=true
# Giscus 客户端脚本地址（一般无需修改）
VITE_GISCUS_CLIENT_SRC=https://giscus.app/client.js
# 存放评论的 GitHub 仓库（owner/repo）
VITE_GISCUS_REPO=LXC-9349/blog-comment
# 仓库 ID（giscus.app 生成）
VITE_GISCUS_REPO_ID=R_kgDOQmj5WA
# Discussion 分类名称
VITE_GISCUS_CATEGORY=Announcements
# 分类 ID
VITE_GISCUS_CATEGORY_ID=DIC_kwDOQmj5WM4CzpLf
# 文章与 Discussion 的映射方式：pathname / url / title / og:title / specific
VITE_GISCUS_MAPPING=pathname
# 严格匹配标题（true / false）
VITE_GISCUS_STRICT=false
# 启用表情回应（true / false）
VITE_GISCUS_REACTIONS=true
# 向 giscus 发送页面元数据（true / false）
VITE_GISCUS_METADATA=false
# 评论输入框位置：top（顶部）/ bottom（底部）
VITE_GISCUS_POSITION=top
# 评论界面语言：zh-CN / en 等
VITE_GISCUS_LANG=zh-CN

# ===========================================
# 站点统计
# ===========================================

# 不蒜子 JSONP 统计接口（页脚：本站访客数 / 总访问量 / 当前页面访问量）
# 接口不可用时页脚显示「统计服务暂时不可用」，不影响页面其他功能
VITE_BUSUANZI_ENDPOINT=https://busuanzi.ibruce.info/busuanzi
# ping0 访客信息图片地址（首页左侧目录下方访客卡片）
# 图片加载失败时该卡片自动隐藏
VITE_PING0_IMAGE_URL=https://ping0.cc/img1

# ===========================================
# 热门标签
# ===========================================

# 手动指定热门标签，英文逗号分隔。
# 留空（推荐）时按文章标签出现频次自动生成
VITE_HOT_TAGS=
# 自动生成时的最大标签数量（正整数）
VITE_HOT_TAGS_LIMIT=12

# ===========================================
# 密码保护（可选）
# 两种方式二选一；同时设置时 BLOG_PASSWORD 优先
# ===========================================

# 方式一（推荐）：填写明文密码。
# 构建时自动生成 PBKDF2-SHA256 哈希（10 万次迭代 + 随机盐），产物中只保留哈希
# 注意：不要加 VITE_ 前缀，否则明文会被 Vite 打包进前端产物
# 留空表示不启用密码保护
BLOG_PASSWORD=

# 方式二：直接填写已生成的哈希。
# 支持两种格式：
# 1) PBKDF2：iterations$salt_base64$hash_base64（推荐）
# 2) 旧版 SHA256：64 位十六进制（可用 node scripts/generate-password-hash.js <密码> 生成）
# 仅当 BLOG_PASSWORD 为空时生效
VITE_BLOG_PASSWORD_HASH=

# ===========================================
# 预留项（当前版本未读取，可保持留空）
# ===========================================
VITE_ENCRYPT_KEY=
VITE_ENCRYPT_IV=

# ===========================================
# 外观默认值（主题设置）
# -------------------------------------------
# 所有键均可选：留空则使用 src/constants/appearance.ts 中的默认值
# 生效顺序：浏览器已保存的用户配置 > 此处默认值 > 代码默认值
# 用户可在首页「主题设置」面板中随时覆盖这些默认值
# ===========================================

# 默认背景 id：public/bg 下的文件名（不含扩展名）；
# 子目录图片用「目录-文件名」表示（如 bb/1.jpg → bb-1）；留空为无背景
VITE_DEFAULT_BACKGROUND=

# 默认字体 id，可选：
# system / system-serif / system-kai / noto-sans / noto-serif / misans / harmony /
# wenkai / smiley / zcool-kuaile / zcool-xiaowei / ma-shan-zheng / long-cang
VITE_DEFAULT_FONT=system

# 默认鼠标样式 id，可选：default / arrow / dot / ring / target / crosshair
# arrow / dot / ring / target 的颜色跟随主题色
VITE_DEFAULT_CURSOR=default

# 默认主题色（HSL）。h：色相 0-360；s：饱和度 0-100；l：明度 0-100（对应 500 色阶）
VITE_DEFAULT_ACCENT_H=25
VITE_DEFAULT_ACCENT_S=94
VITE_DEFAULT_ACCENT_L=53

# 背景自动轮播（true / false，需存在多张背景）
VITE_DEFAULT_AUTO_ROTATE=false
# 背景轮播间隔（秒，5-60）
VITE_DEFAULT_ROTATE_INTERVAL=12
# 背景缓慢缩放（Ken Burns 效果，true / false）
VITE_DEFAULT_KEN_BURNS=false
# 背景遮罩浓度（0-90，步进 5；数值越大文字越清晰）
VITE_DEFAULT_OVERLAY=35

# 页面飘落特效开关（true / false）
VITE_DEFAULT_EFFECT_ENABLED=true
# 特效类型，可多选，英文逗号分隔：
# yinxing（银杏）/ yinghua1（樱花）/ fengye（枫叶）/ meihua（梅花）/ yumao（羽毛）/ xingxing（星星）
VITE_DEFAULT_PETAL_TYPES=yinxing,yinghua1
# 粒子数量（6-150）
VITE_DEFAULT_PETAL_COUNT=50
# 旋转速度（0-5）
VITE_DEFAULT_ROTATION_SPEED=1
# 水平速度（-3 ~ 3，负值向左飘）
VITE_DEFAULT_HORIZONTAL_SPEED=0.5
# 垂直下落速度（0.1-5）
VITE_DEFAULT_VERTICAL_SPEED=1.5
# 飘摆幅度（0-160）
VITE_DEFAULT_PETAL_SWING=60
# 首页特效显示层级（-10 ~ 999；负值位于内容下方）
VITE_DEFAULT_PETAL_Z_INDEX=-5

# ===========================================
# 本地创作台（仅 pnpm dev 生效，不参与生产构建）
# ===========================================

# 访问口令（可选）。
# 默认只允许本机 127.0.0.1 访问 /studio 与内容接口；
# 需要在手机或局域网访问时填写此值，并在创作台页面输入相同口令。
STUDIO_TOKEN=
